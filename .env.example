# Copy to .env (gitignored). Required for LLM calls (Tier B generation/judging).
# Create the key in the DigitalOcean control panel: INFERENCE -> Manage ->
# Create model access key. DO_GRADIENT_API_KEY is accepted as a fallback name.
DO_INFERENCE_API_KEY=

# Optional overrides (defaults shown; verify catalog with `npm run llm:check`)
# LLM_ENDPOINT=https://inference.do-ai.run/v1
# CVT_MODEL_GENERATOR=deepseek-4-flash
# CVT_MODEL_JUDGE=qwen3.5-397b-a17b
# CVT_MODEL_ESCALATION=kimi-k3

# Nixle email ingestion (sbsheriff-nixle-mail). The mailbox subscribed to the
# Chino Hills station's Nixle alerts. Gmail: create an app password under
# Account -> Security -> 2-Step Verification -> App passwords. Without these
# the scraper notes the gap and skips cleanly.
NIXLE_IMAP_USER=
NIXLE_IMAP_PASSWORD=
# NIXLE_IMAP_HOST=imap.gmail.com
# NIXLE_IMAP_PORT=993
# NIXLE_MAIL_ALIAS=chinovalleytoday+nixle@gmail.com
# NIXLE_MAIL_SINCE_DAYS=90

# ---------------------------------------------------------------------------
# Offsite backup to Backblaze B2 (scripts/backup-b2.sh, cvt-backup.timer).
# Droplet only — the local `npm run backup` snapshot needs none of this.
#
# The repository path is created on first run. Use a bucket dedicated to this
# project; restic owns the whole prefix.
RESTIC_REPOSITORY=b2:your-bucket-name:chino-valley-today

# Path to a file holding the restic repository password, NOT the password
# itself. Two reasons it is a file: this droplet also runs four other apps, and
# a value here is loaded into the service environment where it is readable via
# /proc/<pid>/environ, whereas a chmod 600 file is not. And this password is the
# master secret — it decrypts every snapshot, including the API keys above.
#
#   printf '%s' '<long random passphrase>' > /srv/chino-valley-today/.restic-password
#   chmod 600 /srv/chino-valley-today/.restic-password
#   chown cvtoday:cvtoday /srv/chino-valley-today/.restic-password
#
# KEEP A COPY IN A PASSWORD MANAGER. It cannot live only in the bucket it
# protects, and restic has no recovery path without it — lose it and every
# snapshot is permanently unreadable.
RESTIC_PASSWORD_FILE=/srv/chino-valley-today/.restic-password

# B2 application key, from B2 Cloud Storage -> Application Keys -> Add a New
# Application Key. Scope it to the single bucket above, and grant read + write
# but NOT delete: a compromised droplet then cannot destroy backup history,
# which is most of the reason to hold it offsite. This is the "keyID" and
# "applicationKey" pair, not the master key.
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=

# Pruning needs delete capability, so it is off by default and run deliberately
# from a trusted machine with a privileged key:
#   CVT_BACKUP_PRUNE=1 scripts/backup-b2.sh
# CVT_BACKUP_PRUNE=0
# CVT_BACKUP_SKIP_ENV=0

# ---------------------------------------------------------------------------
# Admin dashboard. Binds 127.0.0.1 only; reach it over an SSH tunnel.
# 8788 rather than the 8787 default, which another service on the host holds.
# CVT_ADMIN_PORT=8788
