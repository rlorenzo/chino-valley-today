# Copy to .env (gitignored). Required for LLM calls (Tier B generation/judging).
# Create the key in the DigitalOcean control panel: INFERENCE -> Manage ->
# Create model access key. DO_GRADIENT_API_KEY is accepted as a fallback name.
DO_INFERENCE_API_KEY=

# Optional overrides (defaults shown; verify catalog with `npm run llm:check`)
# LLM_ENDPOINT=https://inference.do-ai.run/v1
# CVT_MODEL_GENERATOR=deepseek-4-flash
# CVT_MODEL_JUDGE=qwen3.5-397b-a17b
# CVT_MODEL_ESCALATION=kimi-k3

# Nixle email ingestion (sbsheriff-nixle-mail). The mailbox subscribed to the
# Chino Hills station's Nixle alerts. Gmail: create an app password under
# Account -> Security -> 2-Step Verification -> App passwords. Without these
# the scraper notes the gap and skips cleanly.
NIXLE_IMAP_USER=
NIXLE_IMAP_PASSWORD=
# NIXLE_IMAP_HOST=imap.gmail.com
# NIXLE_IMAP_PORT=993
# NIXLE_MAIL_ALIAS=chinovalleytoday+nixle@gmail.com
# NIXLE_MAIL_SINCE_DAYS=90

# ---------------------------------------------------------------------------
# Offsite backup to Backblaze B2 (scripts/backup-b2.sh, cvt-backup.timer).
# Droplet only — the local `npm run backup` snapshot needs none of this.
#
# Same mechanism as the Rush Call, SpotTheStar and foreshock backups:
# sqlite3 .backup + gzip, 14 local, rclone copy to a per-project B2 bucket,
# 14 remote. One restore procedure across every project.
#
# Create a DEDICATED bucket and a bucket-scoped Read/Write application key,
# isolated from the other projects' buckets and keys — same convention as
# spotthestar-backups.
RCLONE_REMOTE=b2:chinovalley-backups

# Path to an rclone.conf holding that key, mode 600, owner-only. The
# credentials live only in this file, not in .env, matching the other
# projects. Create it with:  rclone config   (remote type: b2)
RCLONE_CONFIG=/srv/chino-valley-today/rclone.conf

# Local snapshot directory and remote retention. Defaults match the others.
# BACKUP_DIR=/srv/chino-valley-today/backups
# BACKUP_KEEP_REMOTE=14

# ---------------------------------------------------------------------------
# Admin dashboard. Binds 127.0.0.1 only; reach it over an SSH tunnel.
# 8788 rather than the 8787 default, which another service on the host holds.
# CVT_ADMIN_PORT=8788
