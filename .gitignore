node_modules/
data/
.env
*.log
# pipeline working state; only published content is tracked
content/queue/
content/held/
content/rejected/
# Daily briefs are machine-regenerated on the host every morning (cvt-brief).
# Tracking them would trip the deploy guard's divergent-content check daily;
# they are Tier A artifacts fully re-derivable from the database, so they live
# on the host only. Every other published post stays tracked and guarded.
content/published/*-daily-brief.md
.fallow/

# Astro build output and caches (the built site is rsynced, not committed)
site/dist/
site/.astro/
site/node_modules/

# Local screenshot scratch from design review tooling
.playwright-mcp/

# Transient decision-page state from design tooling
.impeccable/questions/

# Per-PR scratch from the review-pr workflow
.review-pr-ignored*

# Deployment target (host, paths). Infrastructure identifiers do not belong in
# a public repo — see deploy/deploy.env.example.
deploy/deploy.env

# rclone remote config — holds the B2 application key. Same convention as the
# other projects: credentials live only here, mode 600, never in git.
rclone.conf
