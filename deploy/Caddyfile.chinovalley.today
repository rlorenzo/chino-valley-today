# Append this block to /etc/caddy/Caddyfile on the droplet.
#
# It is kept OUT of the deploy script on purpose. That Caddyfile also serves
# four other unrelated production sites; a config error takes all four
# down, so this edit is made deliberately by a person who then runs:
#
#   caddy validate --config /etc/caddy/Caddyfile
#   systemctl reload caddy      # reload, never restart — reload is graceful
#
# TLS: CLOUDFLARE ORIGIN CA, so the proxy stays ON permanently.
#
# The records are proxied (orange cloud), which is deliberate — it hides the
# origin address, and this repo is public. That rules out Caddy's automatic
# Let's Encrypt issuance: TLS-ALPN-01 is terminated at Cloudflare's edge and
# never reaches Caddy, and HTTP-01 depends on the zone's SSL mode.
#
# Instead Cloudflare issues a free Origin CA certificate (up to 15 years,
# trusted by Cloudflare specifically) and Caddy simply serves it. No ACME, no
# renewal job, no custom Caddy build, and the proxy never has to be switched
# off — not even briefly.
#
# Generate at: Cloudflare -> SSL/TLS -> Origin Server -> Create Certificate
# (hostnames: chinovalley.today, *.chinovalley.today), then on the droplet:
#
#   install -d -m 700 /etc/caddy/certs
#   # paste the certificate:
#   nano /etc/caddy/certs/chinovalley.today.pem
#   # paste the private key:
#   nano /etc/caddy/certs/chinovalley.today.key
#   chmod 600 /etc/caddy/certs/chinovalley.today.*
#   chown caddy:caddy /etc/caddy/certs/chinovalley.today.*
#
# Then set Cloudflare SSL/TLS mode to FULL (STRICT). Not Flexible: Flexible
# talks to the origin over plain HTTP while Caddy redirects HTTP to HTTPS,
# which is an infinite redirect loop. Not Full: it accepts any origin
# certificate and so verifies nothing.
#
# This certificate is trusted only by Cloudflare, by design. Reaching the
# origin directly will show a certificate error — that is expected, and is the
# point of the proxy.

chinovalley.today, www.chinovalley.today {
	# Explicit cert disables Caddy's automatic HTTPS for this site, which is
	# required here: left automatic, Caddy would keep failing ACME behind the
	# proxy and burn Let's Encrypt rate limits.
	tls /etc/caddy/certs/chinovalley.today.pem /etc/caddy/certs/chinovalley.today.key

	# Static only. No application, no upstream, nothing to exploit — the whole
	# site is files produced by `astro build`.
	root * /var/www/chinovalley.today/current
	file_server

	# `current` is a symlink swapped atomically on each deploy. Caddy resolves
	# it per request, so a deploy needs no reload.

	encode zstd gzip

	# /health is an extensionless file, so file_server would otherwise serve it
	# as application/octet-stream — some monitors and every browser handle that
	# badly. Astro sets these headers on the Response object, but a static build
	# writes only the body to disk and the headers are lost, so they belong here.
	#
	# no-store is not decoration: a cached `ok` outlives the thing it reports on,
	# which is the one way a health check can actively mislead.
	@health path /health
	header @health {
		Content-Type "text/plain; charset=utf-8"
		Cache-Control "no-store"
	}

	# Send www to the bare domain so there is one canonical origin, matching
	# the canonical tags astro emits.
	@www host www.chinovalley.today
	redir @www https://chinovalley.today{uri} permanent

	handle_errors {
		rewrite * /404.html
		file_server
	}

	header {
		# The site ships zero client JS by default, so the CSP can be strict
		# enough to be worth having. 'unsafe-inline' for style-src only:
		# Astro emits scoped <style> blocks.
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; script-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# This is a public civic record; it is meant to be cited and archived.
		X-Robots-Tag "index, follow"
		-Server
	}

	# NO custom log file, deliberately. Access logs go to journald with
	# everything else on this host (`journalctl -u caddy`), which is where the
	# four co-tenant sites already log and where anyone debugging would look.
	#
	# A `log { output file ... }` block was tried and removed: the caddy service
	# runs with ProtectSystem=full and could not open a file under /var/log/caddy
	# even with the directory owned by caddy — and notably `caddy validate`
	# passes anyway, because it never opens the log writer. Loosening hardening
	# on a host serving four other production sites, to gain a log that records
	# Cloudflare edge addresses rather than visitor ones (the requests arrive
	# proxied), was not a trade worth making. Cloudflare's own dashboard holds
	# the visitor data if it is ever wanted.
}
