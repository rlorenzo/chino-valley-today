[Unit]
Description=Chino Valley Today — offsite backup to Backblaze B2 (rclone)
Documentation=https://github.com/rlorenzo/chino-valley-today
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=cvtoday
Group=cvtoday
WorkingDirectory=/srv/chino-valley-today
EnvironmentFile=/srv/chino-valley-today/.env
ExecStart=/usr/bin/env bash scripts/backup-b2.sh

# gzip of a 2MB database plus rclone's transfer buffers. Modest, and still
# capped so it cannot disturb the co-tenant sites.
MemoryHigh=200M
MemoryMax=300M
Nice=15
IOSchedulingClass=idle
CPUWeight=15

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# Writes the local snapshot series; reads everything else.
ReadWritePaths=/srv/chino-valley-today/data /srv/chino-valley-today/backups

# First run mirrors the whole ~104MB archive; later runs upload only new
# content-addressed files.
TimeoutStartSec=2h

[Install]
WantedBy=multi-user.target
