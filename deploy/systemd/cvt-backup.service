[Unit]
Description=Chino Valley Today — offsite backup to Backblaze B2 (restic)
Documentation=https://github.com/rlorenzo/chino-valley-today
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=cvtoday
Group=cvtoday
WorkingDirectory=/srv/chino-valley-today
EnvironmentFile=/srv/chino-valley-today/.env
ExecStart=/usr/bin/env bash scripts/backup-b2.sh

# restic chunks and encrypts in memory; this is the one job here that is
# genuinely memory-hungry. Still capped so it cannot disturb the other sites.
MemoryHigh=350M
MemoryMax=500M
Nice=15
IOSchedulingClass=idle
CPUWeight=15

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# Reads the whole tree; writes only its restic cache. The staging copy of the
# database goes to PrivateTmp.
ReadWritePaths=/srv/chino-valley-today/data
CacheDirectory=cvtoday-restic
Environment=RESTIC_CACHE_DIR=/var/cache/cvtoday-restic

# A 99MB archive over a home-grade uplink, plus B2 round trips.
TimeoutStartSec=2h

[Install]
WantedBy=multi-user.target
