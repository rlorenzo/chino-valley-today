[Unit]
Description=Code-drift check for Chino Valley Today

[Timer]
# Hourly at :47, offset from every other cvt-* unit so this never lands on top
# of a scrape or a build. Hourly rather than daily because the cost is a single
# `git ls-remote` against GitHub, and the failure being watched for — a deploy that
# silently did not happen — is measured in hours of stale code, not days.
OnCalendar=*-*-* *:47:00 America/Los_Angeles
Persistent=true
RandomizedDelaySec=2min

[Install]
WantedBy=timers.target
