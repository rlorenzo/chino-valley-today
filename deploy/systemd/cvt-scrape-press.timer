[Unit]
Description=Press scrapers timer for Chino Valley Today (4x daily)

[Timer]
OnCalendar=*-*-* 05:00:00 America/Los_Angeles
OnCalendar=*-*-* 11:00:00 America/Los_Angeles
OnCalendar=*-*-* 17:00:00 America/Los_Angeles
OnCalendar=*-*-* 23:00:00 America/Los_Angeles
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
