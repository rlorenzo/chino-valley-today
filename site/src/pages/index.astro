---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";
import Entry from "../components/Entry.astro";
import {
	TOPICS,
	briefsOnly,
	formatDate,
	formatLocalDateLong,
	formatLocalDateShort,
	laDatePlus,
	laToday,
	postUrl,
	publishedOnly,
	recordOnly,
	topicsFor,
} from "../lib/record.ts";

const posts = publishedOnly(await getCollection("posts"));

// The daily briefs answer "today"; everything else IS the record.
const briefs = briefsOnly(posts);
const currentBrief = briefs[0] ?? null;
const recentBriefs = briefs.slice(1, 8);
const record = recordOnly(posts);

// Rendered only when a real brief exists. The build must never fake one:
// until the assembler has shipped a brief, the index stays record-led.
const BriefContent = currentBrief ? (await render(currentBrief)).Content : null;

// The "coming up" rail beside the brief: tomorrow's events only — today's
// schedule is in the brief itself, and the full week lives at /calendar/.
// Data is the assembler's events_ahead frontmatter, already sorted by start.
const ahead = currentBrief?.data.events_ahead ?? [];
const tomorrow = currentBrief?.data.brief_date
	? laDatePlus(currentBrief.data.brief_date, 1)
	: null;
const tomorrowEvents = ahead.filter((e) => e.date === tomorrow);
const lastAheadDate = ahead.at(-1)?.date ?? null;

// "This week" is computed from the published record — meeting previews are
// the only forward-dated posts — so it can never claim a meeting the record
// does not contain. The site is rebuilt every morning by cvt-brief, so the
// build-time date is at most a day old.
const today = laToday();
const weekEnd = laDatePlus(today, 7);
const upcoming = record
	.filter(
		(p) =>
			p.data.post_type === "meeting_preview" &&
			p.data.meeting_date !== undefined &&
			p.data.meeting_date >= today &&
			p.data.meeting_date <= weekEnd,
	)
	.map((p) => ({
		post: p,
		cancelled: /cancell?ed/i.test(p.body ?? ""),
	}))
	.sort((a, b) =>
		(a.post.data.meeting_date ?? "").localeCompare(
			b.post.data.meeting_date ?? "",
		),
	);

// Real counts and real dates. A topic with nothing in it says so, because this
// is a record and an empty shelf is information.
const marks = TOPICS.map((t) => {
	const inTopic = record.filter((p) => topicsFor(p).includes(t.slug));
	return {
		...t,
		count: inTopic.length,
		last: inTopic[0]?.data.date ?? null,
	};
});
---

<Base
	title="Chino Valley Today — what to know today in Chino & Chino Hills"
	description="The Chino Valley daily brief: weather, today's meetings and events, and what the councils, the school board, and the commissions actually did — every claim linked to the primary record."
	current="record"
>
	{
		currentBrief && BriefContent ? (
			<section class="today" aria-labelledby="today-heading">
				<div class="shell today__head">
					<h2 id="today-heading" class="mark today__label">
						Today
					</h2>
					<p class="today__date mark">
						{formatLocalDateLong(currentBrief.data.brief_date ?? "")}
					</p>
					<a class="today__perma mark" href={postUrl(currentBrief)}>
						Permanent link · {currentBrief.data.sources.length}
						{currentBrief.data.sources.length === 1 ? " source" : " sources"}
					</a>
				</div>
				<div class="shell today__cols">
					<div class="prose today__prose">
						<BriefContent />
					</div>
					<aside class="today__rail" aria-labelledby="comingup-heading">
						<h3 id="comingup-heading" class="mark today__rail-label">
							Tomorrow{tomorrow && ` · ${formatLocalDateShort(tomorrow)}`}
						</h3>
						{
							tomorrowEvents.length === 0 ? (
								<p class="today__rail-empty">
									Nothing on the posted calendars for tomorrow.
								</p>
							) : (
								<ul class="today__rail-items">
									{tomorrowEvents.map((e) => (
										<li class="today__rail-item">
											{e.time && (
												<span class="mark today__rail-time">{e.time}</span>
											)}
											<a href={e.url} rel="noopener noreferrer">
												{e.title}
											</a>
											{e.venue && (
												<span class="today__rail-venue">{e.venue}</span>
											)}
										</li>
									))}
								</ul>
							)
						}
						{
							ahead.length > 0 && lastAheadDate && (
								<a class="mark today__rail-more" href="/calendar/">
									Full calendar — {ahead.length}
									{ahead.length === 1 ? " event" : " events"} through{" "}
									{formatLocalDateShort(lastAheadDate)}
								</a>
							)
						}
					</aside>
				</div>
			</section>
		) : (
			<section class="lede">
				<div class="shell lede__inner">
					<p class="lede__text">
						What the councils, the school board, and the commissions actually
						did. Every claim carries the record it came from. The morning
						brief begins with its first assembly; nothing is shown here until
						it is real.
					</p>
				</div>
			</section>
		)
	}

	<section class="shell week" aria-labelledby="week-heading">
		<h2 id="week-heading" class="mark week__label">This week</h2>
		<div class="week__cols">
			<div>
				<h3 class="mark week__sub">Meetings ahead</h3>
				{
					upcoming.length === 0 ? (
						<p class="week__empty">
							No upcoming meetings on the record yet — previews appear here as
							agendas are posted.
						</p>
					) : (
						<ol class="week__list">
							{upcoming.map(({ post, cancelled }) => (
								<li class="week__item">
									<span class="mark week__when">{post.data.meeting_date}</span>
									<span>
										<a href={postUrl(post)}>{post.data.title}</a>
										{cancelled && (
											<span class="mark week__cancelled"> cancelled</span>
										)}
									</span>
								</li>
							))}
						</ol>
					)
				}
			</div>
			<div>
				<h3 class="mark week__sub">Recent briefs</h3>
				{
					recentBriefs.length === 0 ? (
						<p class="week__empty">
							{currentBrief
								? "This is the first daily brief; earlier mornings will list here."
								: "None yet — the daily brief has not begun."}
						</p>
					) : (
						<ol class="week__list">
							{recentBriefs.map((b) => (
								<li class="week__item">
									<span class="mark week__when">{b.data.brief_date}</span>
									<span>
										<a href={postUrl(b)}>
											{formatLocalDateLong(b.data.brief_date ?? "")}
										</a>
									</span>
								</li>
							))}
						</ol>
					)
				}
			</div>
		</div>
	</section>

	<section class="shell" aria-labelledby="topics-heading">
		<h2 id="topics-heading" class="sr-only">Topics</h2>
		<div class="marks">
			{
				marks.map((m) => (
					<a class="markcard" href={`/topics/${m.slug}/`}>
						<span class="markcard__name mark">{m.name}</span>
						<span class="markcard__blurb">{m.blurb}</span>
						<span class="markcard__meta mark">
							<span>
								{m.count} {m.count === 1 ? "item" : "items"}
							</span>
							<span>{m.last ? formatDate(m.last) : "none yet"}</span>
						</span>
					</a>
				))
			}
		</div>
	</section>

	<section class="shell record-section" aria-labelledby="record-heading">
		<div class="record-head">
			<h2 id="record-heading" class="mark">The record</h2>
			<p class="record-count mark">
				{record.length} {record.length === 1 ? "entry" : "entries"}
			</p>
		</div>

		{
			record.length === 0 ? (
				<p class="empty">
					Nothing has been published yet. When a meeting is covered, it appears
					here with its sources attached.
				</p>
			) : (
				<ol class="record">
					{record.map((post) => (
						<Entry post={post} />
					))}
				</ol>
			)
		}
	</section>
</Base>

<style>
	/* TODAY — the current brief, led by its date. Same zinc ground as the
	   reading column; the sunk field marks it off without adding depth. */
	.today {
		background: var(--galv-sunk);
		border-bottom: 1px solid var(--galv-edge);
		padding-block: 1.4rem 1.9rem;
	}
	.today__head {
		display: flex;
		align-items: baseline;
		gap: 0.9rem 1.4rem;
		flex-wrap: wrap;
		margin-bottom: 1.1rem;
	}
	.today__label {
		margin: 0;
		font-size: 0.82rem;
		letter-spacing: 0.14em;
	}
	.today__date {
		margin: 0;
		font-size: clamp(0.95rem, 0.85rem + 0.6vw, 1.25rem);
		letter-spacing: 0.08em;
		color: var(--crate);
	}
	.today__perma {
		margin-left: auto;
		font-size: 0.7rem;
		letter-spacing: 0.08em;
		color: var(--muted);
		text-decoration: none;
	}
	.today__perma:hover {
		text-decoration: underline;
	}
	.today__cols {
		display: grid;
		grid-template-columns: minmax(0, var(--measure)) 1fr;
		gap: 1.4rem 3rem;
		align-items: start;
	}
	@media (max-width: 56rem) {
		.today__cols {
			grid-template-columns: 1fr;
		}
		.today__rail {
			border-left: 0;
			border-top: 2px solid var(--galv-edge);
			padding-left: 0;
			padding-top: 1.1rem;
		}
	}
	.today__prose {
		max-width: var(--measure);
	}

	/* COMING UP — the week ahead, filling the field beside the brief. A dense
	   dated list, same ledger discipline as the record: rules, marks, no cards. */
	.today__rail {
		border-left: 2px solid var(--galv-edge);
		padding-left: 1.8rem;
	}
	.today__rail-label {
		margin: 0 0 0.7rem;
		font-size: 0.72rem;
		letter-spacing: 0.13em;
		color: var(--muted);
	}
	.today__rail-empty {
		margin: 0;
		font-size: 0.92rem;
		color: var(--muted);
	}
	.today__rail-items {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.today__rail-item {
		display: grid;
		grid-template-columns: 4.4rem 1fr;
		gap: 0 0.6rem;
		padding-block: 0.3rem;
		font-size: 0.92rem;
		line-height: 1.4;
	}
	.today__rail-time {
		font-size: 0.68rem;
		letter-spacing: 0.06em;
		color: var(--muted);
		padding-top: 0.2rem;
		text-transform: uppercase;
	}
	.today__rail-item > a {
		grid-column: 2;
		grid-row: 1;
		color: var(--stencil);
	}
	.today__rail-venue {
		grid-column: 2;
		font-size: 0.78rem;
		color: var(--muted);
	}
	.today__rail-more {
		display: inline-block;
		margin-top: 0.9rem;
		font-size: 0.7rem;
		letter-spacing: 0.08em;
		color: var(--crate);
		text-decoration: none;
		border-bottom: 2px solid var(--placard);
		padding-bottom: 0.15rem;
	}
	.today__rail-more:hover {
		background: var(--crate);
		color: #fff;
		border-bottom-color: var(--crate);
	}

	/* Record-led fallback, shown only before the first real brief exists. */
	.lede {
		background: var(--galv-sunk);
		border-bottom: 1px solid var(--galv-edge);
	}
	.lede__inner {
		padding-block: 1.6rem 1.7rem;
	}
	.lede__text {
		margin: 0;
		max-width: 44rem;
		font-size: clamp(1.15rem, 1.02rem + 0.75vw, 1.5rem);
		line-height: 1.38;
	}

	/* THIS WEEK — a strip of what is ahead and the mornings just past. */
	.week {
		margin-top: 2.2rem;
	}
	.week__label {
		margin: 0 0 0.9rem;
		font-size: 0.82rem;
		letter-spacing: 0.14em;
	}
	.week__cols {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
		gap: 1.6rem 2.4rem;
		border-top: 2px solid var(--galv-edge);
		padding-top: 1.1rem;
	}
	.week__sub {
		margin: 0 0 0.6rem;
		font-size: 0.72rem;
		letter-spacing: 0.12em;
		color: var(--muted);
	}
	.week__list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.week__item {
		display: grid;
		grid-template-columns: 7.5rem 1fr;
		gap: 0.6rem;
		padding-block: 0.45rem;
		border-bottom: 1px solid var(--galv-edge);
		font-size: 0.95rem;
		line-height: 1.45;
	}
	.week__when {
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		color: var(--muted);
		padding-top: 0.18rem;
	}
	.week__item a {
		color: var(--stencil);
	}
	.week__cancelled {
		font-size: 0.68rem;
		letter-spacing: 0.1em;
		color: var(--muted);
		text-transform: uppercase;
	}
	.week__empty {
		margin: 0;
		font-size: 0.92rem;
		color: var(--muted);
	}

	.marks {
		margin-top: 2.6rem;
	}
	.markcard__blurb {
		font-size: 0.82rem;
		line-height: 1.4;
		color: #cdd8ec;
	}
	.record-section {
		margin-top: 3.2rem;
	}
	.record-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.7rem;
	}
	.record-head h2 {
		margin: 0;
		font-size: 0.82rem;
		letter-spacing: 0.14em;
	}
	.record-count {
		margin: 0;
		font-size: 0.72rem;
		letter-spacing: 0.1em;
		color: var(--muted);
	}
	.empty {
		border: 2px dashed var(--galv-edge);
		padding: 2rem;
		color: var(--muted);
		text-align: center;
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}
</style>
