---
import { getCollection } from "astro:content";
import PostArticle from "../../components/PostArticle.astro";
import Base from "../../layouts/Base.astro";
import { isBrief, typeLabel } from "../../lib/record.ts";

export async function getStaticPaths() {
	// Daily briefs live at their canonical /brief/YYYY-MM-DD URL only —
	// building them here too would publish every brief at two addresses.
	const posts = (await getCollection("posts")).filter((p) => !isBrief(p));
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
---

<Base
	title={`${post.data.title} — Chino Valley Today`}
	description={`${typeLabel(post.data.post_type)} — ${post.data.title}. Every civic claim linked to the primary record.`}
	current="record"
>
	<PostArticle post={post} />
</Base>
